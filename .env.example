# Copy to .env and fill in the secrets. Every non-secret setting below is optional:
# leave it out (or empty) to use the default shown. A variable set in the real
# environment overrides the value in .env.

# ---------------------------------------------------------------- secrets
GOOGLE_API_KEY=
# Langfuse tracing is enabled only when both keys are set.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---------------------------------------------------------------- Elasticsearch
ES_HOST=http://localhost:9200
# Alias that every query goes through; the data lives in ES_INDEX-v1, -v2, ...
# (managed with `python index_admin.py`).
ES_INDEX=document-chunks

# ---------------------------------------------------------------- models
# Changing EMBED_MODEL / EMBED_DIMS means every chunk must be re-embedded into a new
# index -- vectors from different models are not comparable. The sparse search also
# relies on bge-m3's lexical weights (BGEM3FlagModel).
EMBED_MODEL=BAAI/bge-m3
EMBED_DIMS=1024
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.2
# auto = cuda if available, else cpu
MODEL_DEVICE=auto

# ---------------------------------------------------------------- retrieval (per search_documents call)
RETRIEVAL_DENSE_K=20
RETRIEVAL_SPARSE_K=20
# candidates kept after RRF fusion and sent to the reranker
RETRIEVAL_FUSED_TOP_N=20
# passages kept after rerank and given to the LLM (must be <= RETRIEVAL_FUSED_TOP_N)
RETRIEVAL_FINAL_TOP_N=5
# highest-weight query tokens used in the sparse (rank_feature) query
RETRIEVAL_SPARSE_TOP_TOKENS=32
RETRIEVAL_RRF_K=60
# max tokens of (query + passage) the reranker reads
RERANK_MAX_LENGTH=1024

# ---------------------------------------------------------------- ingestion (new uploads only)
CHUNK_TARGET_TOKENS=450
CHUNK_MAX_TOKENS=600
CHUNK_OVERLAP_RATIO=0.15
# lower EMBED_BATCH_SIZE if indexing a large document runs out of GPU memory
EMBED_BATCH_SIZE=32
EMBED_MAX_LENGTH=8192

# ---------------------------------------------------------------- app
# earlier chat messages (user + assistant) sent along with a new question
MAX_HISTORY_MESSAGES=6
# relative paths are resolved against the project folder
CHAT_DB_PATH=chat_history.db
TRACE_NAME=document-qa
